---
const hebrew = Astro.url.pathname.startsWith('/he/');
const instagram = 'https://www.instagram.com/dr._eitan_morris';
const linkedin = 'https://www.linkedin.com/in/eitan-m-b4138a82';
---
<footer class:list={['site-footer', { 'footer-rtl': hebrew }]} dir={hebrew ? 'rtl' : 'ltr'}>
  <a class="wordmark" href={hebrew ? '/he/' : '/'}>{hebrew ? 'ד״ר איתן מוריס' : 'Dr. Eitan Morris'}</a>
  <div class="footer-socials" aria-label={hebrew ? 'רשתות חברתיות' : 'Social media'}>
    <a href={instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram — Dr. Eitan Morris" title="Instagram">
      <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
    </a>
    <a href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn — Dr. Eitan Morris" title="LinkedIn">
      <svg viewBox="0 0 24 24" width="21" height="21" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.35V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>
    </a>
  </div>
  <span>© {new Date().getFullYear()} {hebrew ? 'ד״ר איתן מוריס' : 'Dr. Eitan Morris'}</span>
  <a href="#top">{hebrew ? 'חזרה למעלה ↑' : 'Back to top ↑'}</a>
</footer>