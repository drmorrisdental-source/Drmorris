---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content/site';
---
<Base title="About Dr. Eitan Morris | Dentist" description="Meet Dr. Eitan Morris, a dentist who puts people first.">
  <Header />
  <main id="main" class="subpage redesigned-page">
<section class="subpage-hero about-redesign"><div class="subpage-hero-copy"><span class="eyebrow">MEET YOUR DENTIST</span><h1><span class="soft-heading">Hi, I’m<br />Dr. Eitan</span><br /><span class="orange-heading">Morris.</span></h1><p class="page-lead">A person first.<br />A dentist second.</p><p>I received my dental education from the Hebrew University of Jerusalem, where I currently teach part time.</p><p>I believe that great dental care starts with a real connection. Listening closely, explaining clearly, and understanding the person behind every smile are at the heart of my approach.</p></div><div class="subpage-portrait"><img src="/images/dr-eitan-morris.png" alt="Dr. Eitan Morris smiling in black dental scrubs" width="1312" height="1199" /></div></section>
<section class="education-section"><span class="eyebrow">01 / ACADEMIC BACKGROUND</span><h2><span class="soft-heading">My </span><span class="orange-heading">education.</span></h2><p>The Hebrew University of Jerusalem</p><div class="education-row"><strong>2023 — 2026</strong><div><h3>Doctor of Dental Medicine <span class="orange-heading">(DMD)</span></h3><p>The Hebrew University of Jerusalem</p></div></div><div class="education-row"><strong>2020 — 2023</strong><div><h3>Bachelor of Medical Sciences <span class="orange-heading">(B.Med.Sc)</span></h3><p>The Hebrew University of Jerusalem</p></div></div></section>
<section class="philosophy-section section-pad"><span class="eyebrow">02 / MY PHILOSOPHY</span><div class="philosophy-intro"><h2><span class="soft-heading">A person first.</span><br /><span class="orange-heading">A dentist second.</span></h2><div><p class="page-lead">Good care starts with a real connection.</p><p>My goal is to create a comfortable, personal experience where you feel heard, understand your options, and have the confidence to make informed decisions about your dental care.</p></div></div><div class="principles philosophy-cards"><article><span class="item-number">01 </span><h3>Listen first.</h3><p>Every patient has a different story. I believe in taking the time to understand yours.</p></article><article><span class="item-number">02 </span><h3>Explain clearly.</h3><p>Dental care should feel understandable, with room for questions at every step.</p></article><article><span class="item-number">03 </span><h3>Care personally.</h3><p>A thoughtful treatment experience begins with trust, attention, and communication.</p></article></div></section>
<section class="subpage-contact" id="get-in-touch"><span class="eyebrow">LET’S START WITH A CONVERSATION</span><h2><span>Your next chapter<br />starts </span><span class="orange-heading">with a smile.</span></h2><p>Have a question? I’d love to hear from you.</p><a class="button" href={`mailto:${site.contact.email}`}>Get in touch </a><a class="inline-link" href="/clinics/">Clinics &amp; appointments →</a></section>
</main>
  <Footer />
</Base>
