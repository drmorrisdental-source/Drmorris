---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Clinics & Appointments | Dr. Eitan Morris" description="Clinic locations and appointment booking information for Dr. Eitan Morris are coming soon.">
  <Header />
  <main id="main" class="subpage redesigned-page"><section class="clinics-hero"><span class="eyebrow">CLINICS &amp; APPOINTMENTS</span><h1><span class="soft-heading">The right care.<br />A place </span><span class="orange-heading">near you.</span></h1><span class="coming-soon-label">Coming soon</span><p class="page-lead">Clinic locations, maps, and how to book your appointment. All the details will be right here.</p><a class="button" href="/about/">Meet your dentist </a></section><section class="clinic-info section-pad"><span class="eyebrow">01 / WHAT TO EXPECT</span><h2><span class="soft-heading">A visit that<br />starts </span><span class="orange-heading">with you.</span></h2><p class="page-lead">Whether you’re coming in for a routine visit or have a specific concern, the first step is understanding your needs and helping you feel comfortable.</p><div class="clinic-cards"><article><span class="item-number">01 </span><h3>A personal conversation.</h3><p>Share your concerns, goals, and questions. We’ll begin with what matters to you.</p></article><article><span class="item-number">02 </span><h3>Clear next steps.</h3><p>Understand your options and what to expect before moving forward.</p></article></div></section><section class="clinic-appointments"><span class="eyebrow">02 / APPOINTMENT INFORMATION</span><h2><span class="soft-heading">Everything you need.<br /></span><span class="orange-heading">In one place.</span></h2><p class="page-lead">Clinic addresses, opening hours, and appointment details will be available here soon.</p><div class="clinic-placeholder">Clinic information coming soon</div></section><section class="subpage-contact"><span class="eyebrow">GET IN TOUCH</span><h2><span>Have a question?<br /></span><span class="orange-heading">Let’s talk.</span></h2><p>I look forward to hearing from you.</p><a class="button" href="/about/#get-in-touch">Get in touch </a></section></main>
  <Footer />
</Base>
