---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../content/site';
export function getStaticPaths() { return [{params:{page:undefined},props:{kind:'home'}},{params:{page:'about'},props:{kind:'about'}},{params:{page:'clinics'},props:{kind:'clinics'}}]; }
const { kind } = Astro.props;
const titles={home:'ד״ר איתן מוריס | רפואת שיניים בגישה אישית',about:'קצת עליי | ד״ר איתן מוריס',clinics:'מרפאות וקביעת תורים | ד״ר איתן מוריס'};
const principles=[['קודם כול, מקשיבים.','טיפול טוב מתחיל בהקשבה. חשוב לי להבין מה מביא אותך אליי, מה חשוב לך ומה מעסיק אותך.'],['הסבר ברור, בכל שלב.','להכיר את האפשרויות, לשאול שאלות ולהרגיש בטוחים בהחלטות הנוגעות לטיפול.'],['טיפול אישי באמת.','הצרכים שלך, סדרי העדיפויות שלך והחיוך שלך. הכול מתחיל בראיית האדם שמאחוריהם.']];
const faqs=[['אני חושש מטיפול שיניים. אפשר לדבר על זה קודם?','בוודאי. אפשר לשתף אותי בחששות כדי שנוכל להתייחס אליהם עוד לפני הביקור.'],['מה כדאי להביא לפגישה הראשונה?','צילומי שיניים ומסמכים רפואיים עדכניים, רשימת תרופות ושאלות שתרצו לשאול.'],['אפשר לדבר על אפשרויות הטיפול?','בהחלט. חשוב לי שתכירו את האפשרויות ותוכלו לקבל החלטות מתוך הבנה.']];
const quotes=['אכלתי את הארוחה הראשונה שלי עם התותבות. הופתעתי עד כמה זה עבר טוב — בלי כאב ובנוחות רבה. כל זה בזכות הסבלנות והעבודה הקשה שלך. תודה מעומק הלב על חוויה כל כך מיוחדת.','היכולת שלך לתת לילד שהולך לרופא שיניים תחושה של כיף ורצון לחזור פשוט מדהימה.','היינו אצל כל כך הרבה רופאים ופעם ראשונה הוא היה כל כך רגוע וחזר הביתה וסיפר בהתלהבות.'];
---
<Base title={titles[kind]} description="ד״ר איתן מוריס — רפואת שיניים בגישה אישית, הקשבה וקשר אנושי אמיתי." lang="he">
<Header />
<main id="main" class="hebrew-page redesigned-page">
{kind === 'home' && <>
<section class="he-hero"><div class="he-hero-copy"><h1><span class="soft-heading">החיוך שלך.<br/>הביטחון שלך.</span><br/><span class="orange-heading">המחויבות שלי.</span></h1><p class="page-lead">אני ד״ר איתן מוריס, רופא שיניים. מאמין שטיפול שיניים טוב מתחיל קודם כול בקשר אנושי אמיתי.</p><a class="button" href="/he/about/">נעים להכיר ←</a></div><img src="/images/dr-eitan-morris.png" alt="ד״ר איתן מוריס" width="1312" height="1199"/></section>
<section class="section-pad he-about"><span class="eyebrow">קצת עליי</span><h2><span class="soft-heading">טיפול מקצועי.<br/>קשר </span><span class="orange-heading">אישי.</span></h2><p class="page-lead">מאחורי כל חיוך יש אדם. ומשם אני מתחיל.</p><p>למדתי רפואת שיניים באוניברסיטה העברית בירושלים, שבה אני גם מלמד כיום במשרה חלקית. אני מאמין בהקשבה, בהסברים ברורים ובמתן מקום לשאלות שחשובות לך.</p><div class="he-degrees"><p><strong>DMD</strong> — דוקטור לרפואת שיניים, האוניברסיטה העברית בירושלים · 2023–2026</p><p><strong>B.Med.Sc</strong> — בוגר במדעי הרפואה, האוניברסיטה העברית בירושלים · 2020–2023</p></div><a class="button" href="/he/about/">עוד קצת עליי ←</a></section>
<section class="he-panel section-pad"><span class="eyebrow">הגישה שלי</span><h2><span class="soft-heading">רפואת שיניים</span><br/><span class="orange-heading">ששמה אותך במרכז.</span></h2><div class="he-cards">{principles.map((p,i)=><article><h3>{p[0]}</h3><p>{p[1]}</p></article>)}</div></section>
<section class="he-testimonials section-pad"><span class="eyebrow">במילים של המטופלים</span><span class="he-quote-mark">״</span><div class="he-quote-slides" aria-live="polite">{quotes.map((q,i)=><blockquote class:list={['he-quote',{'is-active':i===0}]} hidden={i!==0}>{q}</blockquote>)}</div><div class="he-quote-controls"><button type="button" class="he-quote-prev" aria-label="המלצה קודמת">›</button><button type="button" class="he-quote-next" aria-label="המלצה הבאה">‹</button></div></section>
<section class="section-pad he-faq"><span class="eyebrow">לפני הביקור</span><h2><span class="soft-heading">כמה שאלות טובות.</span></h2><div class="he-faq-list">{faqs.map(f=><details><summary><span>{f[0]}</span><span class="faq-icon" aria-hidden="true">+</span></summary><p>{f[1]}</p></details>)}</div></section>
<section class="he-contact section-pad"><span class="eyebrow">בואו נתחיל בשיחה</span><h2>הפרק הבא שלך מתחיל<br/><span class="orange-heading">בחיוך.</span></h2><a class="button" href="/he/clinics/">מרפאות וקביעת תורים ←</a></section>
</>}
{kind === 'about' && <>
<section class="he-about-hero section-pad"><div><span class="eyebrow">קצת עליי</span><h1><span class="soft-heading">נעים להכיר,<br/>אני ד״ר איתן</span><br/><span class="orange-heading">מוריס.</span></h1><p class="page-lead">קודם כל בן אדם. אחר כך רופא שיניים</p><p>למדתי רפואת שיניים באוניברסיטה העברית בירושלים, שבה אני גם מלמד כיום במשרה חלקית. אני מאמין שטיפול טוב מתחיל בקשר אנושי אמיתי, בהקשבה ובהסברים ברורים.</p></div><img src="/images/dr-eitan-morris.png" alt="ד״ר איתן מוריס" width="1312" height="1199"/></section>
<section class="he-panel section-pad"><span class="eyebrow">השכלה אקדמית</span><h2><span class="soft-heading">ההשכלה </span><span class="orange-heading">שלי.</span></h2><div class="he-education"><div><strong>2023–2026</strong><div><h3>דוקטור לרפואת שיניים (DMD)</h3><p>האוניברסיטה העברית בירושלים</p></div></div><div><strong>2020–2023</strong><div><h3>בוגר במדעי הרפואה (B.Med.Sc)</h3><p>האוניברסיטה העברית בירושלים</p></div></div></div></section>
<section class="section-pad"><span class="eyebrow">תפיסת העולם שלי</span><h2><span class="soft-heading">קודם כל בן אדם.</span><br/><span class="orange-heading">אחר כך רופא שיניים.</span></h2><p class="page-lead">טיפול טוב מתחיל בקשר אנושי אמיתי.</p><p>המטרה שלי היא ליצור חוויית טיפול אישית ונעימה, שבה מקשיבים לך, מסבירים את האפשרויות ונותנים לך ביטחון לקבל החלטות בנוגע לבריאות הפה שלך.</p><div class="he-cards">{[['קודם כול, להקשיב.','לכל מטופל יש סיפור משלו. חשוב לי להקדיש זמן כדי להכיר את שלך.'],['להסביר בצורה ברורה.','חשוב שטיפול השיניים יהיה מובן, ושיהיה מקום לשאלות בכל שלב.'],['להעניק יחס אישי.','חוויית טיפול טובה מתחילה באמון, בתשומת לב ובתקשורת פתוחה.']].map((p,i)=><article><h3>{p[0]}</h3><p>{p[1]}</p></article>)}</div></section>
<section class="he-contact section-pad" id="get-in-touch"><span class="eyebrow">בואו נתחיל בשיחה</span><h2>הפרק הבא שלך מתחיל<br/><span class="orange-heading">בחיוך.</span></h2><a class="button" href={`mailto:${site.contact.email}`}>יצירת קשר ←</a></section>
</>}
{kind === 'clinics' && <>
<section class="he-clinics-hero he-panel section-pad"><span class="eyebrow">מרפאות וקביעת תורים</span><h1><span class="soft-heading">הטיפול הנכון.<br/>במקום </span><span class="orange-heading">שקרוב אליך.</span></h1><span class="coming-soon-label">בקרוב</span><p class="page-lead">כתובות המרפאות, מפות והמידע על קביעת תורים יופיעו כאן בקרוב.</p></section>
<section class="section-pad"><span class="eyebrow">למה לצפות</span><h2><span class="soft-heading">ביקור שמתחיל</span><br/><span class="orange-heading">בך.</span></h2><p class="page-lead">בין אם מדובר בבדיקה שגרתית ובין אם יש נושא מסוים שמטריד אותך, הצעד הראשון הוא להבין את הצרכים שלך וליצור תחושת נוחות.</p><div class="he-cards he-two-cards"><article><h3>שיחה אישית.</h3><p>נשמע מה חשוב לך, מה מטריד אותך ואילו שאלות יש לך.</p></article><article><h3>המשך הדרך, בצורה ברורה.</h3><p>נכיר את אפשרויות הטיפול ונבין יחד מה צפוי בהמשך.</p></article></div></section>
<section class="he-panel section-pad"><span class="eyebrow">מידע על קביעת תורים</span><h2><span class="soft-heading">כל מה שצריך לדעת.</span><br/><span class="orange-heading">במקום אחד.</span></h2><p class="page-lead">כתובות המרפאות, שעות הפעילות והמידע על קביעת תורים יופיעו כאן בקרוב.</p><div class="he-placeholder">פרטי המרפאות יפורסמו בקרוב</div></section>
<section class="he-contact section-pad"><span class="eyebrow">יצירת קשר</span><h2>יש לך שאלה?<br/><span class="orange-heading">בואו נדבר.</span></h2><p>אשמח לשמוע ממך.</p><a class="button" href="/he/about/#get-in-touch">יצירת קשר ←</a></section>
</>}
</main><Footer/>
</Base>
<script>
const slides = Array.from(document.querySelectorAll<HTMLElement>('.he-quote'));let current=0;function show(n:number){if(!slides.length)return;current=(n+slides.length)%slides.length;slides.forEach((s,i)=>{s.hidden=i!==current;s.classList.toggle('is-active',i===current)})}document.querySelector('.he-quote-next')?.addEventListener('click',()=>show(current+1));document.querySelector('.he-quote-prev')?.addEventListener('click',()=>show(current-1));
</script>