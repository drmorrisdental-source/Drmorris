---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../content/site';
---
<Base>
  <Header />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-photo"><img src="/images/dr-eitan-morris.png" alt="Dr. Eitan Morris smiling in his black dental scrubs" width="1312" height="1199" fetchpriority="high" /></div>
      <div class="hero-title-block"><span class="status-pill"><span aria-hidden="true"></span> A personal approach to dentistry</span><h1 id="hero-title"><span class="soft-heading">Your smile.<br />Your confidence.</span><br /><span class="orange-heading">My commitment.</span></h1></div>
      <div class="hero-intro"><p>I’m Dr. Eitan Morris. A dentist, an educator, and a firm believer that great dental care starts with a real connection.</p><a href="/about/" class="button">Meet your dentist <Arrow diagonal /></a></div>
      <a class="scroll-cue" href="#about" aria-label="Scroll to learn about Dr. Morris">Scroll to explore <span>↓</span></a>
    </section>
    <section class="about section-pad" id="about" aria-labelledby="about-title">
      <div class="section-top"><span class="eyebrow">01 / ABOUT ME</span><span class="tiny-note">A person first. A dentist second.</span></div>
      <div class="about-grid"><h2 id="about-title"><span class="soft-heading">Good care.<br />A real</span><br /><span class="orange-heading">connection.</span></h2><div class="about-copy"><p class="large-copy">Behind every smile is a person. That’s where I start.</p><p>I received my dental education from the Hebrew University of Jerusalem, where I currently teach part time.</p><p>My approach is simple: listen closely, explain clearly, and make room for the questions that matter to you.</p><div class="degree-list"><div class="degree-item"><strong>DMD</strong><div><b>Doctor of Dental Medicine</b><small>Hebrew University of Jerusalem · 2023–2026</small></div></div><div class="degree-item"><strong>B.Med.Sc</strong><div><b>Bachelor of Medical Sciences</b><small>Hebrew University of Jerusalem · 2020–2023</small></div></div></div><a class="button" href="/about/">My background <Arrow diagonal /></a></div></div>
    </section>
    <section class="approach section-pad" id="approach" aria-labelledby="approach-title"><div class="section-top"><span class="eyebrow">02 / THE APPROACH</span><span class="tiny-note">Small details. A meaningful difference.</span></div><h2 id="approach-title"><span class="soft-heading">Dentistry that</span><br /><span class="orange-heading">puts you first.</span></h2><div class="principles">{site.principles.map(item => <article><span class="item-number">{item.number}</span><h3>{item.title}</h3><p>{item.text}</p><Arrow diagonal /></article>)}</div></section>
    <section class="testimonial section-pad" aria-label="Patient testimonials"><span class="eyebrow">IN A PATIENT’S WORDS</span><span class="quote-mark" aria-hidden="true">“</span><div class="testimonial-slides" aria-live="polite">{site.testimonials.map((item,index)=><blockquote class:list={['testimonial-slide',{'is-active':index===0}]} lang={item.lang} dir={item.lang==='he'?'rtl':'ltr'} hidden={index!==0}>{item.text}</blockquote>)}</div><div class="testimonial-controls"><div class="testimonial-dots">{site.testimonials.map((_,index)=><button type="button" class:list={['testimonial-dot',{'is-active':index===0}]} aria-label={`Show testimonial ${index+1}`} aria-current={index===0?'true':undefined} data-index={index}></button>)}</div><div class="testimonial-arrows"><button type="button" class="testimonial-prev" aria-label="Previous testimonial">‹</button><button type="button" class="testimonial-next" aria-label="Next testimonial">›</button></div></div></section><script>const slides=Array.from(document.querySelectorAll<HTMLElement>('.testimonial-slide'));const dots=Array.from(document.querySelectorAll<HTMLButtonElement>('.testimonial-dot'));let active=0;function showTestimonial(next:number){active=(next+slides.length)%slides.length;slides.forEach((s,i)=>{s.hidden=i!==active;s.classList.toggle('is-active',i===active)});dots.forEach((d,i)=>{d.classList.toggle('is-active',i===active);if(i===active)d.setAttribute('aria-current','true');else d.removeAttribute('aria-current')})}dots.forEach((d,i)=>d.addEventListener('click',()=>showTestimonial(i)));document.querySelector('.testimonial-prev')?.addEventListener('click',()=>showTestimonial(active-1));document.querySelector('.testimonial-next')?.addEventListener('click',()=>showTestimonial(active+1));const quoteArea=document.querySelector('.testimonial-slides');let startX:number|null=null;quoteArea?.addEventListener('touchstart',e=>{startX=(e as TouchEvent).changedTouches[0].clientX},{passive:true});quoteArea?.addEventListener('touchend',e=>{if(startX===null)return;const delta=(e as TouchEvent).changedTouches[0].clientX-startX;if(Math.abs(delta)>45)showTestimonial(active+(delta<0?1:-1));startX=null},{passive:true});</script>
    <section class="faq section-pad" aria-labelledby="faq-title"><div><span class="eyebrow">03 / BEFORE YOUR VISIT</span><h2 id="faq-title"><span class="soft-heading">A </span><span class="orange-heading">few good</span><br /><span class="soft-heading">questions.</span></h2></div><div class="faq-list">{site.faqs.slice(0,3).map(item=><details><summary>{item.question}<span class="faq-icon" aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>
    <section class="contact section-pad" id="contact" aria-labelledby="contact-title"><span class="eyebrow">LET’S START WITH A CONVERSATION</span><div class="contact-heading"><h2 id="contact-title"><span class="soft-heading">Your next chapter<br />starts </span><span class="orange-heading">with a smile.</span></h2><span class="contact-arrow" aria-hidden="true">↗</span></div><div class="contact-bottom"><p>Treating patients at select clinic locations.<br /><a class="inline-link" href="/clinics/">Clinics &amp; appointments — coming soon.</a></p><a class="button" href="/about/#get-in-touch">Get in touch <Arrow diagonal /></a></div></section>
  </main>
  <Footer />
</Base>
